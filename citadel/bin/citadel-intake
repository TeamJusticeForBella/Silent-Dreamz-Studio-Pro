#!/usr/bin/env python3
"""
citadel-intake — ingest one file into the Citadel evidence pipeline.

    citadel-intake <source-file> \\
        --source "iPhone / Jason" \\
        --evidence-type photo \\
        --event-date 2026-10-01 \\
        --event-date-precision day \\
        --notes "screenshot of text thread" \\
        [--root /path/to/citadel/root]

Prints a JSON receipt to stdout (evidence_id, sha256, integrity_status,
queue_status) — this is exactly what the iPhone Shortcut is meant to
receive back and display.

Safety:
  - Refuses to run if free disk space on the target root's filesystem is
    below the configured minimum (default 5 GiB). Nothing is copied,
    nothing is created, in that case.
  - Never overwrites an existing original. A second intake of the *same*
    bytes creates a new evidence_id and is flagged as a duplicate of the
    earlier one; the earlier evidence is untouched (JASON GATE: existing
    evidence is never modified, moved, or renamed by this tool).
"""
import argparse
import json
import mimetypes
import os
import sys
from datetime import datetime, timezone

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
import citadel_core as cc  # noqa: E402

ACTOR = "citadel-intake"


def parse_args(argv):
    p = argparse.ArgumentParser(description="Intake one file into Citadel.")
    p.add_argument("source_file", help="Path to the file to ingest")
    p.add_argument("--source", required=True, help='Who/what this came from, e.g. "iPhone / Jason"')
    p.add_argument("--evidence-type", required=True, choices=sorted(cc.EVIDENCE_TYPES))
    p.add_argument("--event-date", default=None, help="YYYY-MM-DD or other date string")
    p.add_argument(
        "--event-date-precision",
        default="unknown",
        choices=sorted(cc.EVENT_DATE_PRECISIONS),
    )
    p.add_argument("--notes", default="")
    p.add_argument("--root", default=None, help="Override Citadel root (default: ~/Citadel)")
    return p.parse_args(argv)


def main(argv=None):
    args = parse_args(argv if argv is not None else sys.argv[1:])
    config = cc.CitadelConfig(root=args.root)

    if not os.path.isfile(args.source_file):
        print(json.dumps({"error": f"no such file: {args.source_file}"}))
        return 2

    ok, free_gib, min_gib = cc.check_disk_safety_gate(config)
    if not ok:
        print(
            json.dumps(
                {
                    "error": "DISK_SAFETY_GATE",
                    "message": f"only {free_gib:.2f} GiB free on {config.root}'s filesystem; "
                    f"minimum required is {min_gib:.2f} GiB. Refusing to copy or process evidence.",
                    "free_gib": round(free_gib, 2),
                    "min_gib": min_gib,
                }
            )
        )
        return 3

    cc.init_db(config)
    for d in cc.CitadelConfig.STORAGE_SUBDIRS:
        os.makedirs(config.path(d), exist_ok=True)

    original_filename = os.path.basename(args.source_file)
    byte_size = os.path.getsize(args.source_file)
    mime_type = cc.guess_mime(args.source_file)
    sha256_at_intake = cc.sha256_file(args.source_file)
    acquired_at = cc.utcnow_iso()

    with cc.open_db(config) as conn:
        duplicate_of = None
        dup_row = conn.execute(
            "SELECT evidence_id FROM evidence WHERE sha256 = ? ORDER BY created_at ASC LIMIT 1",
            (sha256_at_intake,),
        ).fetchone()
        if dup_row:
            duplicate_of = dup_row["evidence_id"]

        evidence_id = cc.next_evidence_id(conn)

        original_path = config.path("01_ORIGINALS", f"{evidence_id}_{original_filename}")
        working_copy_path = config.path("02_WORKING_COPIES", f"{evidence_id}_{original_filename}")

        if os.path.exists(original_path):
            # Should be impossible given evidence_id is freshly minted, but
            # never overwrite an existing original under any circumstance.
            print(json.dumps({"error": "original_path already exists, aborting", "path": original_path}))
            return 4

        # Insert the evidence row now, before any file copy, so every
        # subsequent audit_log/hashes FK reference is valid even if a
        # later step (e.g. a post-copy hash mismatch) aborts the intake.
        # That failed attempt then stays visible in the index rather than
        # vanishing silently.
        conn.execute(
            """INSERT INTO evidence (
                evidence_id, original_filename, source, evidence_type, event_date,
                event_date_precision, acquired_at, sha256, byte_size, mime_type,
                original_path, working_copy_path, processing_status, ocr_status,
                transcription_status, notes, integrity_status, duplicate_of, created_at
            ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
            (
                evidence_id, original_filename, args.source, args.evidence_type, args.event_date,
                args.event_date_precision, acquired_at, sha256_at_intake, byte_size, mime_type,
                original_path, working_copy_path, "INTAKE_IN_PROGRESS", "NOT_STARTED",
                "NOT_STARTED", args.notes, "PENDING", duplicate_of, acquired_at,
            ),
        )

        import shutil as _shutil
        _shutil.copy2(args.source_file, original_path)
        cc.audit(conn, evidence_id, "ORIGINAL_COPIED", ACTOR, {"path": original_path})

        sha256_post_copy = cc.sha256_file(original_path)
        if sha256_post_copy != sha256_at_intake:
            cc.audit(
                conn, evidence_id, "INTEGRITY_ALERT", ACTOR,
                {"stage": "post_copy", "expected": sha256_at_intake, "actual": sha256_post_copy},
            )
            conn.execute(
                "UPDATE evidence SET integrity_status = 'INTEGRITY_ALERT', processing_status = 'FAILED' "
                "WHERE evidence_id = ?",
                (evidence_id,),
            )
            print(json.dumps({"error": "INTEGRITY_ALERT", "message": "hash changed during copy; aborting intake"}))
            return 5

        cc.audit(conn, evidence_id, "HASH_ORIGINAL", ACTOR, {"sha256": sha256_at_intake})

        try:
            os.chmod(original_path, 0o444)
        except OSError:
            pass  # best-effort; documented as non-authoritative protection

        _shutil.copy2(original_path, working_copy_path)
        os.chmod(working_copy_path, 0o644)
        cc.audit(conn, evidence_id, "WORKING_COPY_CREATED", ACTOR, {"path": working_copy_path})

        conn.execute(
            "INSERT INTO hashes (evidence_id, sha256, algo, stage, computed_at) VALUES (?, ?, 'sha256', 'intake', ?)",
            (evidence_id, sha256_at_intake, acquired_at),
        )

        sidecar = {
            "evidence_id": evidence_id,
            "original_filename": original_filename,
            "source": args.source,
            "evidence_type": args.evidence_type,
            "event_date": args.event_date,
            "event_date_precision": args.event_date_precision,
            "acquired_at": acquired_at,
            "sha256": sha256_at_intake,
            "byte_size": byte_size,
            "mime_type": mime_type,
            "original_path": original_path,
            "working_copy_path": working_copy_path,
            "processing_status": "QUEUED",
            "ocr_status": "NOT_STARTED",
            "transcription_status": "NOT_STARTED",
            "notes": args.notes,
            "integrity_status": "OK",
        }
        cc.write_sidecar(config, evidence_id, sidecar)
        cc.audit(conn, evidence_id, "SIDECAR_WRITTEN", ACTOR, {"evidence_id": evidence_id})

        conn.execute(
            "UPDATE evidence SET processing_status = 'QUEUED', integrity_status = 'OK' "
            "WHERE evidence_id = ?",
            (evidence_id,),
        )

        conn.execute(
            "INSERT INTO events (evidence_id, event_date, event_date_precision, description, created_at) "
            "VALUES (?, ?, ?, ?, ?)",
            (evidence_id, args.event_date, args.event_date_precision, args.notes, acquired_at),
        )

        if duplicate_of:
            cc.audit(conn, evidence_id, "DUPLICATE_DETECTED", ACTOR, {"duplicate_of": duplicate_of})

        adapters = cc.detect_adapters()
        queue_status = {}
        for job_type in cc.ADAPTER_TYPES:
            applies = cc.ADAPTER_ROUTING[job_type](mime_type)
            if not applies:
                continue
            adapter_info = adapters[job_type]
            status = "QUEUED" if adapter_info["status"] == "CONNECTED" else "NOT_CONNECTED"
            now = cc.utcnow_iso()
            conn.execute(
                "INSERT INTO processing_jobs (evidence_id, job_type, status, adapter_status, detail, created_at, updated_at) "
                "VALUES (?, ?, ?, ?, ?, ?, ?)",
                (evidence_id, job_type, status, adapter_info["status"], adapter_info["detail"], now, now),
            )
            queue_status[job_type] = status
        cc.audit(conn, evidence_id, "PROCESSING_JOBS_QUEUED", ACTOR, {"jobs": queue_status})

        receipt = {
            "evidence_id": evidence_id,
            "sha256": sha256_at_intake,
            "integrity_status": "OK",
            "queue_status": queue_status,
            "duplicate_of": duplicate_of,
        }

        cc.append_intake_log(config, {
            "ts": acquired_at,
            "action": "INTAKE",
            "evidence_id": evidence_id,
            "original_filename": original_filename,
            "sha256": sha256_at_intake,
            "source": args.source,
            "evidence_type": args.evidence_type,
            "duplicate_of": duplicate_of,
        })

    print(json.dumps(receipt, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
