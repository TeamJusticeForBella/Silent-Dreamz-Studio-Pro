#!/usr/bin/env python3
"""
citadel-status — read-only dashboard: disk safety gate, adapter
connectivity, evidence counts, port 22 state on *this* host, recent
audit log entries.

V1.1: this is now LITERALLY read-only. It never calls os.makedirs(),
never runs CREATE TABLE, never INSERTs anything. If 05_INDEX/citadel.db
doesn't exist, it reports db_status="NOT_INITIALIZED" instead of
creating one. The DB (when present) is opened with SQLite's `mode=ro`
URI flag (citadel_core.open_db_readonly), which refuses writes at the
driver level — so even a bug in this script's own SQL couldn't mutate
the database.

    citadel-status [--root ...] [--json]
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
import citadel_core as cc  # noqa: E402


def parse_args(argv):
    p = argparse.ArgumentParser(description="Citadel status / dashboard (read-only).")
    p.add_argument("--root", default=None)
    p.add_argument("--json", action="store_true", help="machine-readable output")
    return p.parse_args(argv)


def gather(config: cc.CitadelConfig):
    ok, free_gib, min_gib = cc.check_disk_safety_gate(config)
    adapters = cc.detect_adapters()
    port22 = cc.port_listening("127.0.0.1", 22)

    report = {
        "citadel_root": config.root,
        "root_exists": os.path.isdir(config.root),
        "disk": {
            "free_gib": round(free_gib, 2),
            "min_required_gib": min_gib,
            "safety_gate_ok": ok,
        },
        "port_22_listening_on_this_host": port22,
        "adapters": adapters,
        "db_status": "NOT_INITIALIZED",
        "evidence": {"total": 0, "by_type": {}, "by_integrity_status": {}, "by_intake_state": {}},
        "recent_audit": [],
        "audit_chain": {"status": "NO_LOG", "entries": 0},
    }

    try:
        with cc.open_db_readonly(config) as conn:
            report["db_status"] = "OK"
            total = conn.execute("SELECT COUNT(*) c FROM evidence").fetchone()["c"]
            report["evidence"]["total"] = total
            for row in conn.execute("SELECT evidence_type, COUNT(*) c FROM evidence GROUP BY evidence_type"):
                report["evidence"]["by_type"][row["evidence_type"]] = row["c"]
            for row in conn.execute("SELECT integrity_status, COUNT(*) c FROM evidence GROUP BY integrity_status"):
                report["evidence"]["by_integrity_status"][row["integrity_status"]] = row["c"]
            for row in conn.execute("SELECT intake_state, COUNT(*) c FROM evidence GROUP BY intake_state"):
                report["evidence"]["by_intake_state"][row["intake_state"]] = row["c"]
            for row in conn.execute(
                "SELECT evidence_id, action, actor, timestamp FROM audit_log ORDER BY id DESC LIMIT 10"
            ):
                report["recent_audit"].append(dict(row))
    except FileNotFoundError:
        pass  # db_status stays NOT_INITIALIZED; no mutation attempted, nothing created

    # Read-only: verify_chain() only opens the log file for reading.
    report["audit_chain"] = cc.verify_chain(config.intake_log_path)

    return report


def print_human(report):
    print(f"Citadel root:      {report['citadel_root']}  (exists: {report['root_exists']})")
    d = report["disk"]
    gate = "PASS" if d["safety_gate_ok"] else "FAIL — below minimum, intake refused"
    print(f"Disk safety gate:  {gate}  ({d['free_gib']} GiB free / {d['min_required_gib']} GiB min)")
    print(f"Port 22 (this host, not necessarily the target Mac): "
          f"{'LISTENING' if report['port_22_listening_on_this_host'] else 'not listening'}")
    print("Adapters:")
    for name, info in report["adapters"].items():
        print(f"  {name:22s} {info['status']:14s} {info['detail']}")
    print(f"DB status: {report['db_status']}")
    if report["db_status"] == "OK":
        print(f"Evidence total: {report['evidence']['total']}")
        if report["evidence"]["by_type"]:
            print(f"  by type:         {report['evidence']['by_type']}")
        if report["evidence"]["by_integrity_status"]:
            print(f"  by integrity:    {report['evidence']['by_integrity_status']}")
        if report["evidence"]["by_intake_state"]:
            print(f"  by intake_state: {report['evidence']['by_intake_state']}")
        if report["recent_audit"]:
            print("Recent audit log:")
            for e in report["recent_audit"]:
                print(f"  [{e['timestamp']}] {e['action']:24s} {e['evidence_id']}  ({e['actor']})")
    ac = report["audit_chain"]
    print(f"Audit chain (06_LOGS/intake.log): {ac['status']}"
          + (f" ({ac['entries']} entries)" if ac["status"] == "OK" else ""))


def main(argv=None):
    args = parse_args(argv if argv is not None else sys.argv[1:])
    config = cc.CitadelConfig(root=args.root)
    report = gather(config)
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print_human(report)
    return 0


if __name__ == "__main__":
    sys.exit(main())
