{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "bcc_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "english_stop", "english_stemmer"]
        }
      },
      "filter": {
        "english_stop": {
          "type": "stop",
          "stopwords": "_english_"
        },
        "english_stemmer": {
          "type": "stemmer",
          "language": "english"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "workspace_id": { "type": "keyword" },
      "draft_id": { "type": "keyword" },
      "draft_type": { "type": "keyword" },
      "status": { "type": "keyword" },
      "title": {
        "type": "text",
        "analyzer": "bcc_text",
        "fields": {
          "raw": { "type": "keyword" }
        }
      },
      "body_md": {
        "type": "text",
        "analyzer": "bcc_text"
      },
      "incident_id": { "type": "keyword" },
      "packet_id": { "type": "keyword" },
      "created_at": { "type": "date" },
      "updated_at": { "type": "date" }
    }
  }
}
