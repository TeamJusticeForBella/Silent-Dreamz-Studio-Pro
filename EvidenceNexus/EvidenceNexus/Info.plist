<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>EvidenceNexus</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
    </dict>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>armv7</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Privacy Permissions -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>EvidenceNexus needs access to your Photos library to import photos and videos as evidence. All files are copied, never moved, to preserve chain of custody.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>EvidenceNexus may save evidence exports to your Photos library.</string>

    <key>NSMicrophoneUsageDescription</key>
    <string>EvidenceNexus needs microphone access to record voice notes as evidence.</string>

    <key>NSSpeechRecognitionUsageDescription</key>
    <string>EvidenceNexus uses on-device speech recognition to transcribe audio and video evidence. All processing happens on your device for maximum privacy.</string>

    <key>NSCameraUsageDescription</key>
    <string>EvidenceNexus needs camera access to capture photos and videos as evidence.</string>

    <key>NSFaceIDUsageDescription</key>
    <string>EvidenceNexus uses Face ID to securely protect your sensitive evidence vault.</string>

    <key>NSContactsUsageDescription</key>
    <string>EvidenceNexus may access contacts to link evidence to specific people.</string>

    <key>NSCalendarsUsageDescription</key>
    <string>EvidenceNexus may access calendar data to verify timeline information.</string>

    <!-- URL Scheme for External AI Coordination -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>com.evidencenexus.urlscheme</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>evidencenexus</string>
            </array>
        </dict>
    </array>

    <!-- App Intents / Siri Integration -->
    <key>NSUserActivityTypes</key>
    <array>
        <string>SearchEvidenceIntent</string>
        <string>GetPatternSummaryIntent</string>
        <string>AddVoiceNoteIntent</string>
        <string>QuickImportIntent</string>
    </array>

    <!-- Background Modes (if needed for processing) -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>processing</string>
    </array>

    <!-- File Sharing (Disabled for Security) -->
    <key>UIFileSharingEnabled</key>
    <false/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <false/>

    <!-- Data Protection -->
    <key>NSSupportsLiveActivities</key>
    <false/>
</dict>
</plist>
